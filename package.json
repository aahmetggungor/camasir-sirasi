{
  "name": "camasir-sirasi",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev --workspace @camasir/web",
    "mobile": "npm run start --workspace @camasir/mobile",
    "android": "npm run android --workspace @camasir/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:web": "npm run build --workspace @camasir/web",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
